# PUBLIC PRODUCTION SETTINGS
PORT=3000
NODE_ENV=production

# Your public backend URL (HTTPS)
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example

# Gemini - BACKEND ONLY
GEMINI_API_KEY=YOUR_GEMINI_KEY

# Google OAuth Web Client
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Must exactly match Google Cloud OAuth redirect URI
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN.example/oauth2callback

# Generate a long random secret
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
